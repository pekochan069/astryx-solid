{
  "name": "astryx-solid-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp lint && bun run test && bun run build",
    "parity": "bun run --filter @astryx-solid/verification parity",
    "build": "vp run --filter './apps/*' --filter './packages/*' build",
    "dev": "vp run --parallel --filter './apps/*' --filter './packages/*' dev",
    "test": "bun test packages/verification/tests && bun run --cwd packages/build test && bun run --cwd packages/core test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "@solidjs/signals": "2.0.0-beta.19",
    "@solidjs/web": "2.0.0-beta.19",
    "solid-js": "2.0.0-beta.19",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4"
  }
}
