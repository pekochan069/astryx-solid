    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "rolldown": "^1.1.5",
    "rolldown-plugin-dts": "^0.27.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "vite": "^8.1.5"
