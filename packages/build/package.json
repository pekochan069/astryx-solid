{
  "name": "@astryx-solid/build",
  "version": "0.1.0",
  "description": "Vite Plus StyleX integration for Astryx Solid packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pekochan069/astryx-solid.git",
    "directory": "packages/build"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
