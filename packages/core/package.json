{
  "name": "@astryx-solid/core",
  "version": "0.1.0",
  "description": "Solid-native Astryx base types, styling, themes, and localization.",
  "homepage": "https://github.com/pekochan069/astryx-solid#readme",
  "bugs": {
    "url": "https://github.com/pekochan069/astryx-solid/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pekochan069/astryx-solid.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "locales"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*.css",
    "./locales/*.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./astryx.css": "./dist/astryx.css",
    "./reset.css": "./dist/reset.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./visually-hidden": {
      "types": "./dist/visually-hidden.d.ts",
      "default": "./dist/visually-hidden.js"
    },
    "./naming": {
      "types": "./dist/naming.d.ts",
      "default": "./dist/naming.js"
    },
    "./stylex": {
      "types": "./dist/stylex.d.ts",
      "default": "./dist/stylex.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./theme/tokens": {
      "types": "./dist/theme/tokens.d.ts",
      "default": "./dist/theme/tokens.js"
    },
    "./theme/tokens.stylex": {
      "types": "./dist/theme/tokens.stylex.d.ts",
      "default": "./dist/theme/tokens.stylex.js"
    },
    "./theme/syntax": {
      "types": "./dist/theme/syntax.d.ts",
      "default": "./dist/theme/syntax.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./locales/*.json": "./locales/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -c -w",
    "test": "bun --conditions=browser test --preload ./tests/setup.ts",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-beta.19",
    "@stylexjs/stylex": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "bumpp": "^12.0.0",
    "happy-dom": "^20.11.1",
    "rolldown": "^1.1.5",
    "rolldown-plugin-dom-expressions-compiler": "^0.1.1",
    "rolldown-plugin-dts": "^0.27.6",
    "solid-js": "2.0.0-beta.19",
    "typescript": "^7",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-beta.19",
    "@stylexjs/stylex": "^0.19.0",
    "solid-js": "^2.0.0-beta.19"
  },
  "browserslist": [
    "Chrome >= 123",
    "Firefox >= 120",
    "Safari >= 17.5"
  ]
}
